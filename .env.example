# Runtime config override for SELF-HOSTING (optional).
# Copy this file to .env.local and fill in YOUR values, then rebuild:
#   npm run build
#
# Without this file the app uses the built-in defaults from src/lib/env.ts.
# Full guide: SELF-HOSTING.md

# Your Supabase project URL (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key (same page — "anon public")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public address of THIS app deployment, no trailing slash.
# Used as the OAuth redirect target after Google sign-in.
# Local testing: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
